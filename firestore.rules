rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public Schemes Directory
    // Public can read all active schemes; only authenticated administrators can create, update, or delete
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Citizen Scheme Notifications / Subscriptions
    // Citizens can subscribe (create), but only admins can list or manage subscribers
    match /scheme_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // User profiles (if any)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback rule: deny all other collections unless explicitly authenticated
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
